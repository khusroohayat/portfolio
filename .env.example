# SMTP configuration for contact form email delivery
# Copy this file to .env.local and fill in your SMTP credentials

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
CONTACT_TO_EMAIL=your_destination_email@example.com
CONTACT_FROM_EMAIL=portfolio-contact@example.com
