{
  "name": "portfolio-website-azure-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "a11y": "jest --testPathPatterns=accessibility.test.js --verbose",
    "a11y:ci": "jest --testPathPatterns=accessibility.test.js --ci --watchAll=false",
    "audit:lighthouse": "node scripts/lighthouse-audit.js",
    "ci": "npm run lint:eslint && npm run format:check && npm run test:ci && npm run a11y:ci && npm run build && npm run audit:lighthouse",
    "prepare": "husky"
  },
  "dependencies": {
    "@azure/openai": "^1.0.0-beta.11",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.10.7",
    "@next/eslint-plugin-next": "^14.2.5",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.1.1",
    "chrome-launcher": "^1.2.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.1",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.1.1",
    "jest-junit": "^16.0.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.1.6",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
